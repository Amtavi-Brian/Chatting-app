# Copy this file to .env (local dev) or configure these as environment
# variables in your hosting provider for production builds.

# Base URL of the backend REST API (no trailing slash)
REACT_APP_API_URL=http://127.0.0.1:8000

# Base URL of the backend WebSocket endpoint (no trailing slash)
REACT_APP_WS_URL=ws://127.0.0.1:8000
